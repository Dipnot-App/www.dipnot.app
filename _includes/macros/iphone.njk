{#
  3D iPhone (17 Pro proportions, Deep Blue) around an app screenshot.

  screen  img/opt basename; expects -450 and -900 widths in AVIF + WebP
          (scripts/build-images.js)
  alt     screenshot description (Turkish)
  rot     "rx,ry,rz" resting rotation in degrees; motion.js animates
          from/around it, CSS uses it as the static pose
  inset   true when the screenshot has no status bar (cropped): the
          screen reserves the status-bar strip above it
  eager   true for the hero (no lazy loading, high fetch priority)
#}
{% macro iphone(screen, alt, rot="0,0,0", inset=false, eager=false, mod="") %}
{%- set r = rot.split(",") -%}
<div class="dn-iphone {{ mod }}" data-iphone data-rot="{{ rot }}" style="--rx: {{ r[0] }}deg; --ry: {{ r[1] }}deg; --rz: {{ r[2] }}deg">
  <div class="dn-iphone__edge" aria-hidden="true">
    {%- for i in range(1, 15) %}<span style="--i: {{ i }}"></span>{% endfor -%}
  </div>
  <span class="dn-iphone__key dn-iphone__key--action" aria-hidden="true"></span>
  <span class="dn-iphone__key dn-iphone__key--vol-up" aria-hidden="true"></span>
  <span class="dn-iphone__key dn-iphone__key--vol-down" aria-hidden="true"></span>
  <span class="dn-iphone__key dn-iphone__key--power" aria-hidden="true"></span>
  <span class="dn-iphone__key dn-iphone__key--camera" aria-hidden="true"></span>
  <div class="dn-iphone__body">
    <div class="dn-iphone__front">
      <div class="dn-iphone__screen{% if inset %} dn-iphone__screen--inset{% endif %}">
        <picture>
          <source type="image/avif" srcset="/img/opt/{{ screen }}-450.avif 450w, /img/opt/{{ screen }}-900.avif 900w" sizes="(min-width: 1024px) 320px, 70vw">
          <source type="image/webp" srcset="/img/opt/{{ screen }}-450.webp 450w, /img/opt/{{ screen }}-900.webp 900w" sizes="(min-width: 1024px) 320px, 70vw">
          <img src="/img/opt/{{ screen }}-900.webp" alt="{{ alt }}" width="900" height="1310"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %} data-iphone-screen>
        </picture>
        <span class="dn-iphone__island" aria-hidden="true"></span>
        <span class="dn-iphone__glare" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>
{% endmacro %}
