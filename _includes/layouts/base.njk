<!DOCTYPE html>
<html lang="{{ lang or 'tr' }}" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="{{ site.author }}">
  <meta name="description" content="{{ description }}">
  {%- if keywords %}
  <meta name="keywords" content="{{ keywords }}">
  {%- endif %}
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta http-equiv="Permissions-Policy" content="geolocation=(), camera=(), microphone=(), payment=()">
  <meta name="theme-color" content="{{ site.themeColor }}">
  {%- if robots %}
  <meta name="robots" content="{{ robots }}">
  {%- endif %}
  {%- for alt in hreflang %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href }}">
  {%- endfor %}
  {%- if og %}

  <!-- Open Graph -->
  <meta property="og:type" content="{{ og.type or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ og.locale or 'tr_TR' }}">
  {%- if og.localeAlternate %}
  <meta property="og:locale:alternate" content="{{ og.localeAlternate }}">
  {%- endif %}
  <meta property="og:title" content="{{ og.title or title }}">
  <meta property="og:description" content="{{ og.description or description }}">
  <meta property="og:url" content="{{ og.url }}">
  {#- OG set per dna_core_docs assets/og/README.md: default first, square
      second; X gets the horizontal render. A page's own og.image wins. #}
  {%- if og.image %}
  <meta property="og:image" content="{{ og.image }}">
  {%- else %}
  <meta property="og:image" content="{{ site.ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Dipnot">
  <meta property="og:image" content="{{ site.ogImageSquare }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200">
  <meta property="og:image:alt" content="Dipnot">
  {%- endif %}

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og.title or title }}">
  <meta name="twitter:description" content="{{ og.description or description }}">
  <meta name="twitter:image" content="{{ og.image or site.twitterImage }}">
  {%- endif %}

  <title>{{ title }}</title>
  <!-- Theme + capability flags before first paint (no theme flash) -->
  <script>
    (function () {
      var d = document.documentElement, t;
      try { t = localStorage.getItem("theme"); } catch (e) {}
      if (t !== "light" && t !== "dark") {
        t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      }
      d.setAttribute("data-theme", t);
      var b = navigator.userAgentData && navigator.userAgentData.brands;
      if (b && b.some(function (x) { return x.brand === "Chromium"; })) d.classList.add("dn-refract");
      {%- if pageMotion %}
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        d.classList.add("dn-motion", "dn-intro");
        // Safety net: if GSAP never arrives, show the content anyway.
        setTimeout(function () { if (!window.__dnMotionReady) d.classList.remove("dn-motion"); }, 2500);
      }
      {%- endif %}
    })();
  </script>
  <!-- Inter, self-hosted (see @font-face in styles.css) -->
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin>
  {%- if not noBulma %}
  <!-- Bulma CDN (legacy: legal pages' content/forms only) -->
  <link rel="stylesheet" href="{{ site.cdn.bulma.href }}" integrity="{{ site.cdn.bulma.integrity }}" crossorigin="anonymous">
  {%- endif %}
  <!-- Font Awesome CDN — loaded without blocking first paint (icons are
       decorative; text renders first). SRI still applies. -->
  <link rel="preload" as="style" href="{{ site.cdn.fontAwesome.href }}" integrity="{{ site.cdn.fontAwesome.integrity }}" crossorigin="anonymous" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="{{ site.cdn.fontAwesome.href }}" integrity="{{ site.cdn.fontAwesome.integrity }}" crossorigin="anonymous"></noscript>
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/styles.css?v={{ site.cssVersion }}">

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/img/icons/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/icons/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
</head>
<body>
  <a class="dn-skip" href="#main">İçeriğe geç</a>

  <!-- Ambient ocean background -->
  <div class="dn-ocean" aria-hidden="true">
    <div class="dn-ocean__deep"></div>
    <div class="dn-ocean__glow dn-ocean__glow--a"></div>
    <div class="dn-ocean__glow dn-ocean__glow--b"></div>
    <div class="dn-ocean__rays"></div>
    <div class="dn-ocean__motes"></div>
    <div class="dn-ocean__grain"></div>
  </div>

  <!-- Liquid-glass refraction filter (Chromium backdrop-filter: url()) -->
  <svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
    <filter id="dn-refract" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="noise"/>
      <feGaussianBlur in="noise" stdDeviation="2" result="soft"/>
      <feDisplacementMap in="SourceGraphic" in2="soft" scale="38" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>

  {%- if not hideNav %}
  {% include "partials/nav.njk" %}
  {%- endif %}

{{ content | safe }}

  {% include "partials/footer.njk" %}

  <!-- Scripts -->
  <script src="/js/main.js?v={{ site.jsVersion }}"></script>
  <script src="/js/newsletter.js?v={{ site.jsVersion }}"></script>
  {%- if hasContactForm %}
  <script src="/js/contact.js?v={{ site.jsVersion }}"></script>
  {%- endif %}
  {%- if pageMotion %}
  <script src="{{ site.cdn.gsap.href }}" integrity="{{ site.cdn.gsap.integrity }}" crossorigin="anonymous" defer></script>
  <script src="{{ site.cdn.scrollTrigger.href }}" integrity="{{ site.cdn.scrollTrigger.integrity }}" crossorigin="anonymous" defer></script>
  <script src="{{ site.cdn.splitText.href }}" integrity="{{ site.cdn.splitText.integrity }}" crossorigin="anonymous" defer></script>
  <script src="/js/motion.js?v={{ site.jsVersion }}" defer></script>
  {%- endif %}
  {%- if pageModule %}
  <script type="module" src="/js/{{ pageModule }}?v={{ site.jsVersion }}"></script>
  {%- endif %}
</body>
</html>
