{#- 404 only: deep-sea creatures drifting behind the content. Inline SVG
    silhouettes, decorative (aria-hidden). Motion is transform/opacity
    only and stops with prefers-reduced-motion. -#}
<div class="dn-abyss" aria-hidden="true">
  <svg width="0" height="0" style="position: absolute">
    <defs>
      <radialGradient id="dn-lure" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#e9fff7" />
        <stop offset="35%" stop-color="#7dffd8" />
        <stop offset="100%" stop-color="#7dffd8" stop-opacity="0" />
      </radialGradient>
    </defs>
  </svg>

  {#- Anglerfish: drifts left → right -#}
  <div class="dn-abyss__swim dn-abyss__swim--angler">
    <svg class="dn-abyss__angler" viewBox="0 0 240 160">
      <path class="dn-abyss__body" d="M44 84 L8 50 L20 84 L8 120 Z" />
      <path class="dn-abyss__fin" d="M92 34 L98 14 L106 32 L114 10 L120 30 L128 16 L132 32 Z" />
      <path class="dn-abyss__body" d="M42 84 C40 44 92 26 142 32 C178 38 202 52 210 70 L152 88 L206 112 C190 134 150 146 110 144 C64 142 44 122 42 84 Z" />
      <path class="dn-abyss__fin" d="M98 128 C94 146 80 154 66 152 C80 142 88 132 92 124 Z" />
      <path class="dn-abyss__mouth" d="M210 70 L152 88 L206 112 Z" />
      <path class="dn-abyss__teeth" d="M204 72 L201 90 M193 75 L189 95 M182 78 L180 94 M171 81 L169 96 M161 84 L160 94 M162 91 L164 79 M174 96 L177 81 M186 101 L189 85 M198 107 L201 91" />
      <path class="dn-abyss__stalk" d="M140 32 C132 -2 194 -6 210 22" />
      <circle class="dn-abyss__glow" cx="210" cy="24" r="24" fill="url(#dn-lure)" />
      <circle class="dn-abyss__lure" cx="210" cy="24" r="5" />
      <circle class="dn-abyss__eye" cx="158" cy="54" r="6.5" />
      <circle class="dn-abyss__pupil" cx="159" cy="54" r="2" />
    </svg>
  </div>

  {#- Viperfish: drifts right → left (mirrored) -#}
  <div class="dn-abyss__swim dn-abyss__swim--viper">
    <svg class="dn-abyss__viper" viewBox="0 0 240 80">
      <path class="dn-abyss__body" d="M14 40 L0 24 L4 40 L0 56 Z" />
      <path class="dn-abyss__body" d="M12 40 C46 22 150 20 200 32 C216 36 226 40 224 46 C206 54 132 58 52 50 C30 48 18 46 12 40 Z" />
      <path class="dn-abyss__fin" d="M120 24 L132 10 L138 24 Z" />
      <path class="dn-abyss__fang" d="M216 42 C222 58 214 70 206 76 M206 44 C209 56 202 64 197 67 M219 37 C227 27 225 17 217 12" />
      <circle class="dn-abyss__eye" cx="204" cy="36" r="5" />
      <g class="dn-abyss__dots">
        <circle cx="60" cy="49" r="1.6" /><circle cx="78" cy="51" r="1.6" />
        <circle cx="96" cy="52" r="1.6" /><circle cx="114" cy="52" r="1.6" />
        <circle cx="132" cy="52" r="1.6" /><circle cx="150" cy="51" r="1.6" />
        <circle cx="168" cy="49" r="1.6" /><circle cx="186" cy="47" r="1.6" />
      </g>
    </svg>
  </div>

  {#- Something watching from the dark -#}
  <svg class="dn-abyss__eyes" viewBox="0 0 60 20">
    <ellipse cx="14" cy="10" rx="6" ry="4" />
    <ellipse cx="46" cy="10" rx="6" ry="4" />
  </svg>
</div>
