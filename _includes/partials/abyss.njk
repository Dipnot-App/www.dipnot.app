{#- 404 only: deep-sea creatures drifting behind the content. Engravings
    from public-domain natural-history plates (see scripts/build-abyss.js
    for sources), used as CSS masks so each theme tints them. Decorative
    (aria-hidden); transform/opacity only; still with reduced motion. -#}
<div class="dn-abyss" aria-hidden="true">
  {#- A giant shark facing us, far back in the dark: a blurred head-on
      silhouette whose eyes catch the light, looming in and fading out -#}
  <svg class="dn-shark" viewBox="0 0 400 260">
    <g class="dn-shark__body">
      <path d="M182 70 L200 6 L218 70 Z" />
      <path d="M98 138 L4 222 L136 160 Z" />
      <path d="M302 138 L396 222 L264 160 Z" />
      <path d="M52 118 C86 76 148 60 200 60 C252 60 314 76 348 118 C326 152 272 178 200 190 C128 178 74 152 52 118 Z" />
    </g>
    <path class="dn-shark__mouth" d="M146 160 Q200 186 254 160 Q200 174 146 160 Z" />
    {#- Small almond eyes; only a thin crescent catches the light -#}
    <g class="dn-shark__eye" transform="translate(90 114) rotate(-8)">
      <ellipse class="dn-shark__ball" rx="7.5" ry="3.6" />
      <path class="dn-shark__shine" d="M-5.5 -0.6 Q0 -4.2 5.5 -0.6 Q0 -2.4 -5.5 -0.6 Z" />
      <circle class="dn-shark__glint" cx="2" cy="-1.4" r="0.9" />
    </g>
    <g class="dn-shark__eye" transform="translate(310 114) rotate(8)">
      <ellipse class="dn-shark__ball" rx="7.5" ry="3.6" />
      <path class="dn-shark__shine" d="M-5.5 -0.6 Q0 -4.2 5.5 -0.6 Q0 -2.4 -5.5 -0.6 Z" />
      <circle class="dn-shark__glint" cx="-2" cy="-1.4" r="0.9" />
    </g>
  </svg>
  <div class="dn-abyss__swim dn-abyss__swim--angler">
    <div class="dn-abyss__bob">
      <div class="dn-abyss__fish" style="--src: url(/img/abyss/anglerfish.webp); aspect-ratio: 900 / 481"></div>
      <span class="dn-abyss__lure"></span>
    </div>
  </div>
  <div class="dn-abyss__swim dn-abyss__swim--viper">
    <div class="dn-abyss__bob"><div class="dn-abyss__fish" style="--src: url(/img/abyss/viperfish.webp); aspect-ratio: 1000 / 310"></div></div>
  </div>
  <div class="dn-abyss__swim dn-abyss__swim--fang">
    <div class="dn-abyss__bob"><div class="dn-abyss__fish" style="--src: url(/img/abyss/fangtooth.webp); aspect-ratio: 900 / 466"></div></div>
  </div>
</div>
