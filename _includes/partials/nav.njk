{%- set t = i18n[lang or "tr"] -%}
<!-- NAVIGATION — floating liquid-glass bar -->
<header class="dn-nav" data-nav>
  <nav class="dn-nav__bar dn-glass dn-glass--pill" aria-label="{{ t.navLabel }}">
    <a class="dn-nav__brand" href="{{ t.home }}">
      <img src="/img/logos/logo.svg" alt="" width="32" height="32">
      Dipnot
    </a>

    <ul class="dn-nav__links">
      <li><a href="{{ t.home }}#about">{{ t.nav.about }}</a></li>
      <li><a href="{{ t.home }}#features">{{ t.nav.features }}</a></li>
      <li><a href="{{ t.home }}#how-it-works">{{ t.nav.how }}</a></li>
      <li><a href="{{ t.home }}#faq">{{ t.nav.faq }}</a></li>
      <li><a href="{{ t.home }}#contact">{{ t.nav.contact }}</a></li>
    </ul>

    <div class="dn-nav__actions">
      <span class="dn-nav__divider" aria-hidden="true"></span>
      <div class="dn-settings" role="group" aria-label="{{ t.settingsLabel }}">
        <div class="dn-seg" role="group" aria-label="Dil / Language">
          {%- for code in ["tr", "en"] %}
          {%- if code == (lang or "tr") %}
          <span class="dn-seg__item is-active" aria-current="true" lang="{{ code }}">{{ code | upper }}</span>
          {%- else %}
          <a class="dn-seg__item" href="{{ hreflang | altUrl(code, i18n[code].home) }}" hreflang="{{ code }}" lang="{{ code }}" aria-label="{{ t.langSwitch.label }}" data-lang-switch="{{ code }}">{{ code | upper }}</a>
          {%- endif %}
          {%- endfor %}
        </div>
        <button id="theme-toggle" type="button" class="dn-btn dn-btn--icon dn-theme-toggle" aria-label="{{ t.theme }}">
          {% icon "moon" %}
          {% icon "sun" %}
        </button>
      </div>
      <a href="{{ t.home }}#download" class="dn-btn dn-btn--primary dn-nav__download">{{ t.download }}</a>
      <button type="button" class="dn-burger" aria-label="{{ t.menuOpen }}" aria-expanded="false" aria-controls="navbar" data-target="navbar">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile sheet -->
  <div id="navbar" class="dn-sheet dn-glass dn-glass--strong">
    <ul>
      <li><a href="{{ t.home }}">{{ t.nav.home }}</a></li>
      <li><a href="{{ t.home }}#about">{{ t.nav.about }}</a></li>
      <li><a href="{{ t.home }}#features">{{ t.nav.features }}</a></li>
      <li><a href="{{ t.home }}#how-it-works">{{ t.nav.how }}</a></li>
      <li><a href="{{ t.home }}#faq">{{ t.nav.faq }}</a></li>
      <li><a href="{{ t.home }}#contact">{{ t.nav.contact }}</a></li>
    </ul>
    {% include "partials/store-buttons.njk" %}
  </div>
</header>
