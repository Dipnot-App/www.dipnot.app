{#- Turkish page with an English counterpart: offered to English-browser
    visitors by main.js (never an automatic redirect). -#}
{%- if (lang or "tr") == "tr" and (hreflang | altUrl("en", "")) %}
<aside class="dn-langhint dn-glass dn-glass--strong" lang="en" data-lang-hint hidden>
  <p>This page is also available in English.</p>
  <a class="dn-btn dn-btn--primary" href="{{ hreflang | altUrl('en', '/en/') }}" hreflang="en">English version</a>
  <button type="button" class="dn-btn dn-btn--icon dn-langhint__close" aria-label="Close" data-lang-hint-close>
    {% icon "xmark" %}
  </button>
</aside>
{%- endif %}
