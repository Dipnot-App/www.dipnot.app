{%- set tm = team[lang or "tr"] -%}
<!-- HERO BANNER -->
<section class="hero has-background-hero">
  <div class="hero-body">
    <div class="columns">
      <div class="column">
        <h1 class="title is-size-1 has-text-white mb-5">{{ tm.title }}</h1>
      </div>
    </div>
  </div>
</section>

<!-- MAIN PAGE -->
<main id="main" class="container py-6">
  <section class="section dn-team">
    <p class="dn-lead dn-team__lead">{{ tm.lead }}</p>
    <ul class="dn-team__grid">
      {%- for m in tm.members %}
      <li class="dn-team__card dn-glass dn-glass--strong">
        {%- if m.photo %}
        <picture class="dn-team__photo">
          <source type="image/avif" srcset="/img/opt/{{ m.photo }}-256.avif 256w, /img/opt/{{ m.photo }}-384.avif 384w" sizes="8rem">
          <source type="image/webp" srcset="/img/opt/{{ m.photo }}-256.webp 256w, /img/opt/{{ m.photo }}-384.webp 384w" sizes="8rem">
          <img class="dn-team__avatar" src="/img/opt/{{ m.photo }}-256.webp" alt="" width="128" height="128" loading="lazy" decoding="async">
        </picture>
        {%- else %}
        <span class="dn-team__avatar" aria-hidden="true">{{ m.initials }}</span>
        {%- endif %}
        <div class="dn-team__body">
          <h2 class="dn-h3 dn-team__name">{{ m.name }}</h2>
          <p class="dn-team__role">{{ m.role }}</p>
          <p class="dn-team__summary">{{ m.summary | safe }}</p>
          {%- if m.bio %}
          <details class="dn-team__more">
            <summary>{{ tm.more }} {% icon "chevron-down" %}</summary>
            <div class="dn-team__bio">
              {%- for p in m.bio %}
              <p>{{ p | safe }}</p>
              {%- endfor %}
            </div>
          </details>
          {%- endif %}
          {%- if m.links %}
          <p class="dn-team__links">
            {%- for l in m.links %}
            <a href="{{ l.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ l.label }}">{% icon l.icon %}</a>
            {%- endfor %}
          </p>
          {%- endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
  </section>
</main>
