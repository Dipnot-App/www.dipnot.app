{%- set st = i18n[lang or "tr"].store -%}
<div class="dn-store"{% if storeReveal %} data-reveal{% endif %}>
  <a href="https://play.google.com/store/apps/details?id=com.vacstudio.dipnot" target="_blank" rel="noopener noreferrer" class="dn-btn dn-glass dn-glass--pill dn-store__btn">
    <img src="/img/svg/google-play.svg" alt="" width="28" height="28">
    <span class="dn-store__label"><small>{{ st.get }}</small><span>Google Play</span></span>
  </a>
  <a href="https://apps.apple.com/app/id6757102330" target="_blank" rel="noopener noreferrer" class="dn-btn dn-glass dn-glass--pill dn-store__btn">
    {% icon "brands:apple", "dn-i--2x" %}
    <span class="dn-store__label"><small>{{ st.apple or st.get }}</small><span>App Store</span></span>
  </a>
</div>
