{
  "name": "www-dipnot-app",
  "private": true,
  "version": "1.0.0",
  "description": "Dipnot landing page — static site, built with Eleventy.",
  "scripts": {
    "build": "eleventy",
    "build:og": "node scripts/build-og.js",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:a11y": "pa11y-ci --sitemap http://localhost:8080/sitemap.xml",
    "check:lighthouse": "lhci autorun",
    "check:links": "lychee --no-progress _site",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=critical"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@lhci/cli": "^0.15.0",
    "html-validate": "^11.5.6",
    "http-server": "^14.1.1",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.4",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "cookie": "^0.7.0"
  }
}
