{
  "name": "www-dipnot-app",
  "private": true,
  "version": "2.0.0",
  "description": "Dipnot landing page — static site, built with Eleventy.",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "eleventy",
    "build:og": "node scripts/build-og.js",
    "build:images": "node scripts/build-images.js",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:a11y": "pa11y-ci --config .pa11yci.json",
    "check:lighthouse": "lhci autorun",
    "check:links": "lychee --no-progress _site",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=critical"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@lhci/cli": "^0.15.0",
    "html-validate": "^11.16.1",
    "http-server": "^14.1.1",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "cookie": "^0.7.0"
  }
}
