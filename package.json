{
  "name": "www-dipnot-app",
  "private": true,
  "version": "2.0.4",
  "description": "Dipnot landing page — static site, built with Eleventy.",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "eleventy",
    "build:og": "node scripts/build-og.js",
    "build:images": "node scripts/build-images.js",
    "build:brand": "node scripts/build-brand-pack.js",
    "build:abyss": "node scripts/build-abyss.js",
    "build:shark": "esbuild src/shark3d.js --bundle --format=esm --minify --target=es2020 --legal-comments=eof --outfile=js/shark3d.js",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:a11y": "pa11y-ci --config .pa11yci.json",
    "check:lighthouse": "lhci autorun",
    "check:links": "lychee --no-progress _site",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=critical"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@gltf-transform/cli": "4.5.1",
    "@lhci/cli": "^0.15.0",
    "esbuild": "0.28.2",
    "html-validate": "^11.16.2",
    "http-server": "^14.1.1",
    "lightningcss": "1.33.0",
    "pa11y-ci": "^5.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "@lhci/cli": {
      "uuid": "^11.1.1",
      "tmp": "^0.2.6"
    },
    "basic-ftp": "^6.2.3"
  }
}
